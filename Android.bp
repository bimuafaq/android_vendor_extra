android_app_import {
    name: "FlorisBoard",
    apk: "FlorisBoard/FlorisBoard.apk",
    presigned: true,
}

android_app_import {
    name: "Aperture",
    apk: "Aperture/Aperture.apk",
    certificate: "platform",
    overrides: [
        "Camera2",
        "Snap",
    ],
}
